# Public Agora App ID: required at build and runtime.
NEXT_PUBLIC_AGORA_APP_ID=

# Server runtime only. Never expose this certificate to the browser or build arguments.
NEXT_AGORA_APP_CERTIFICATE=

# Optional, server-only: a Shopify Catalog bearer token. Leave empty for a limited anonymous local trial.
# Tokens obtained from Shopify expire and must be renewed.
SHOPIFY_CATALOG_ACCESS_TOKEN=

# Optional: your public HTTPS UCP agent profile. Local trials use Shopify's hosted example.
SHOPIFY_UCP_AGENT_PROFILE_URL=
